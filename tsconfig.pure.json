{
  // The layers that must not touch the browser: without DOM in `lib`, a stray
  // `window` or `document` fails the typecheck. The LCD's canvas painter and the
  // layer entry that re-exports it are the only browser-facing parts of `lcd/`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pure.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core", "src/world", "src/lcd"],
  "exclude": ["src/lcd/index.ts", "src/lcd/canvas-painter*.ts"]
}
